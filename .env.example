# EcoGuard Ghana — copy to `.env` (NEVER commit `.env`).
# Values come from Firebase Console → Project settings → Your apps → Web app
# SDK configuration. These keys are public-by-design; data is protected by
# Firestore/Storage security rules, never by key secrecy.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=eco-guard-ghana.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eco-guard-ghana
VITE_FIREBASE_STORAGE_BUCKET=eco-guard-ghana.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: public Earth Engine App URL for the earth-section button.
# Leave empty until the app is published (button then opens the EE gate).
VITE_EE_APP_URL=
